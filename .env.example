# ==============================================================================
# FRONTEND CONFIGURATION (Client-side / Public)
# Prefixed with VITE_ to be exposed to the browser bundle
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PROJECT_ID=your-project-id

# ==============================================================================
# BACKEND CONFIGURATION (Server-side / Private - NEVER expose to browser)
# Used by Nitro server runtime, SSR functions, and administrative tasks
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
